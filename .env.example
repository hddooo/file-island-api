# HanQ API — environment template. Copy to your own local environment; never commit real values.
# Every value below is intentionally empty. Production refuses to start without the required ones.

# production | development | test
NODE_ENV=
PORT=

# PostgreSQL. Supply only from your own local/secret environment. Never print or commit it.
# Supabase "Session pooler" (IPv4, port 5432) works: postgresql://<user>:<password>@<pooler-host>:5432/postgres
# The JDBC form jdbc:postgresql://<pooler-host>:5432/postgres?user=<user>&password=<password> is also accepted (parsed in memory).
DATABASE_URL=
# verify-full (default, required in production) | disable (allowed only for a loopback host outside production)
HANQ_DB_SSL_MODE=
# Path to a server CA certificate (PEM). Optional for Supabase hosts: certs/supabase-prod-ca-2021.crt (pinned fingerprint,
# fetch with `npm run ca:supabase`) is used by default. rejectUnauthorized and hostname verification always stay on.
HANQ_DB_CA_FILE=
HANQ_DB_POOL_MAX=

# JWT: two different random secrets, each at least 32 bytes (e.g. 64 hex chars). Generate locally; never reuse.
# (Older names JWT_ACCESS_SECRET / JWT_REFRESH_SECRET are read only when these are empty; differing values fail startup.)
HANQ_JWT_ISSUER=
HANQ_JWT_ACCESS_SECRET=
HANQ_JWT_REFRESH_SECRET=
HANQ_ACCESS_TTL_SECONDS=604800
HANQ_REFRESH_TTL_SECONDS=
HANQ_SESSION_MAX_SECONDS=

# Exact browser origins allowed to call the API with credentials, comma separated (https only in production).
HANQ_CORS_ORIGINS=
# Refresh cookie: strict | lax | none (none requires Secure; cross-site cookies may be blocked by browsers)
HANQ_COOKIE_SAMESITE=
# true | false (forced true in production)
HANQ_COOKIE_SECURE=
# Number of trusted reverse-proxy hops in front of the API (0 = none)
HANQ_TRUST_PROXY=

HANQ_RATE_LIMIT_PER_MINUTE=
HANQ_AUTH_RATE_LIMIT_PER_MINUTE=
HANQ_LOGIN_FAILURES_PER_15MIN=

# Premium pass period policy (pending owner confirmation): calendar-month (default) | fixed-days
HANQ_PREMIUM_PERIOD=
HANQ_PREMIUM_FIXED_DAYS=

# Payment provider: none (default; checkout answers 503) | test (development/test only, blocked in production)
HANQ_PAYMENT_PROVIDER=

# Seed source: path to the static front repository (default ../hanq_front)
HANQ_FRONT_DIR=

# Integration tests only: must point at a loopback host and a database whose name ends with _test.
HANQ_TEST_DATABASE_URL=

# Optional self-service test pass; off by default. Requires migration 006.
HANQ_TEST_FREE_PREMIUM_ENABLED=false

# Authenticated CBT (requires migration 007). ABSOLUTE path of a PRIVATE directory (outside Git and any public/static
# folder) holding the canonical question images RR-NN.webp and shared images RR-commonAA-BB.webp (see docs/cbt.md).
# Empty/missing/unreadable: only the CBT image routes answer 503 asset_unavailable; startup and every other feature work.
HANQ_CBT_ASSET_DIR=
# Optional absolute path of a private manifest {"files":{"79-01.webp":"<sha256 hex>"}}; when set, every served file must match.
HANQ_CBT_ASSET_MANIFEST=


# Member-only textbook study: all existing authenticated HanQ members may read.
# Defaults to the exact private API-repo directory private-textbook-data; absent bundle returns 503.
# HANQ_TEXTBOOK_OWNER_USER_ID is obsolete and ignored.
# Optional absolute private read-only data mount outside this repo and every frontend/static/CDN root.
# Contains manifest.json, pages/page-NNN.json, renders/page-NNN.png, enhanced/page-NNN.png.
HANQ_TEXTBOOK_DATA_DIR=
