name: API independent checks
on:
  push:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: api-independent-ci-${{ github.ref }}
  cancel-in-progress: true
jobs:
  independent:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: package-lock.json
      - run: npm ci --no-fund
      - run: npm run typecheck
      - name: Unit tests independent of private frontend fixtures
        shell: bash
        run: |
          set -euo pipefail
          npx --no-install tsc -p tsconfig.json
          mapfile -t tests < <(find dist/test/unit -name '*.test.js' ! -name 'catalog.test.js' ! -name 'quality-revision.test.js' | sort)
          test "${#tests[@]}" -gt 0
          node --test --test-concurrency=1 "${tests[@]}"
      - run: npm run build
      - name: Report coverage boundary
        if: always()
        shell: bash
        run: |
          printf '%s\n' 'This CI uses no application secrets or production database.' >> "$GITHUB_STEP_SUMMARY"
          printf '%s\n' 'catalog.test.js and quality-revision.test.js require private FE fixtures and are not run. PostgreSQL integration and optional local-original fixtures are not covered.' >> "$GITHUB_STEP_SUMMARY"
      - name: Existing lint gate (runs after tests to preserve test evidence)
        if: always()
        run: npm run lint
  release-image:
    needs: independent
    if: github.repository == 'blockmonkey1992/hanq_api' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '24'
      - name: Build and verify pinned API image without production access
        run: node scripts/build-release-image.cjs --build
      - name: Retain private image archive and source/checksum proof
        id: artifact
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: hanq-api-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: release-artifact/
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Record artifact identity
        env:
          ARTIFACT_ID: ${{ steps.artifact.outputs.artifact-id }}
          ARTIFACT_DIGEST: ${{ steps.artifact.outputs.artifact-digest }}
        run: |
          printf 'Private API image artifact: %s\nSHA256: %s\nNo production deployment performed.\n' "$ARTIFACT_ID" "$ARTIFACT_DIGEST" >> "$GITHUB_STEP_SUMMARY"
