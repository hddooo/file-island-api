{
  "name": "hanq-back",
  "version": "0.1.0",
  "private": true,
  "description": "HanQ (한국사 한눈에) API — NestJS + PostgreSQL (schema hanq). Own JWT auth, server grading, premium pass, payments adapter.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/unit/**/*.test.js\"",
    "integration": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/integration/**/*.test.js\"",
    "migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/seed.js",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/main.js",
    "ca:supabase": "tsc -p tsconfig.build.json && node dist/scripts/fetch-supabase-ca.js",
    "check:growth-floor": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/check-growth-floor.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
