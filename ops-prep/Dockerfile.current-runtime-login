ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS public_files
USER 0
COPY --chown=0:0 --chmod=0755 artifacts/ /tmp/public-five/
RUN ["node","-e","const fs=require('node:fs');fs.chmodSync('/tmp/public-five/premium/premium.controller.js',420);fs.utimesSync('/tmp/public-five',1794276323,1794276323)"]
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
COPY --from=public_files --chown=0:0 /tmp/public-five/ /app/dist/src/
