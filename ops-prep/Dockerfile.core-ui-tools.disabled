FROM mcr.microsoft.com/playwright@sha256:ee15712262f017b8157421b212b12099146645f44b1bc5c0514cbbe6a229b1d0
WORKDIR /qa
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json ./
RUN npm ci --no-fund --ignore-scripts
ARG FRONTEND_TOOLS_LOCK_SHA256
LABEL hanq.playwright.version="1.64.1" hanq.frontend.tools.lock.sha256=$FRONTEND_TOOLS_LOCK_SHA256
USER pwuser
ENTRYPOINT ["node"]
