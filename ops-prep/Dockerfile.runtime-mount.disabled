# INACTIVE PROPOSAL: not built, not production-qualified. See docs/repository-migration.md.
# Official Node24 linux/amd64 runtime resolved 2026-10-30; no mutable base tag.
FROM node:24-bookworm-slim@sha256:a43f7fc3e52e87d12a905f46eea0275def84ca8f2981a5b53fed44d7fb398ee0 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-fund
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY scripts ./scripts
RUN npm run build && npm prune --omit=dev --no-fund

FROM node:24-bookworm-slim@sha256:a43f7fc3e52e87d12a905f46eea0275def84ca8f2981a5b53fed44d7fb398ee0 AS runtime
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/hddooo/file-island-api" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY migrations ./migrations
COPY certs/supabase-prod-ca-2021.crt ./certs/supabase-prod-ca-2021.crt
USER node
EXPOSE 8080
# Startup never runs the general automatic migrator. The reviewed, mounted
# bootstrap must first prove exact approved schema/checksums and physical shape.
CMD ["node", "/run/hanq-production/bootstrap.mjs"]
